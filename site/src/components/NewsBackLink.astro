---
// Header back link component for News release detail articles.
// Prefixes link with Astro's BASE_URL for GitHub Pages deployment.

const prefix = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<a href={prefix + '/news/'} class="news-back-link">
	<svg
		xmlns="http://www.w3.org/2000/svg"
		width="14"
		height="14"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<path d="m15 18-6-6 6-6"></path>
	</svg>
	<span class="news-back-text">Back to all updates</span>
</a>
