---
import { Icon } from '@astrojs/starlight/components';
import { releases } from '../data/releases';

// No props. Each page's neighbours come from its position in src/data/releases.ts,
// so adding a release cannot leave the page before it pointing at the wrong thing.
// That is the defect this replaced: v1.5.0 still read "All releases" long after
// v1.6.0 shipped, because its next link was written by hand on the page itself.

const prefix = import.meta.env.BASE_URL.replace(/\/+$/, '');

// The last path segment is the page's own slug, and is free of `base`.
const path = Astro.url.pathname.replace(/\/+$/, '');
const slug = path.slice(path.lastIndexOf('/') + 1);

const index = releases.findIndex((release) =>
	release.slug.replace(/\/+$/, '').endsWith(`/${slug}`)
);

// Fail the build rather than render dead links. A news page missing from the list
// would otherwise read "All releases" in both directions and look deliberate.
if (index === -1) {
	throw new Error(
		`News page "${slug}" is not listed in src/data/releases.ts. ` +
			'Add an entry there so the grid and the pagination both pick it up.'
	);
}

const allReleases = { label: 'All releases', href: '/news/' };
const toLink = (release: (typeof releases)[number]) => ({
	label: `${release.version} — ${release.title}`,
	href: release.slug,
});

// The list runs newest first, so the older release sits after the current one.
const older = releases[index + 1];
const newer = releases[index - 1];

const prev = older ? toLink(older) : allReleases;
const next = newer ? toLink(newer) : allReleases;
---

<div class="pagination-links print:hidden not-content" dir="ltr">
	{
		prev && (
			<a href={prefix + prev.href} rel="prev">
				<Icon name="left-arrow" size="1.5rem" />
				<span>
					Previous
					<br />
					<span class="link-title">{prev.label}</span>
				</span>
			</a>
		)
	}
	{
		next && (
			<a href={prefix + next.href} rel="next">
				<Icon name="right-arrow" size="1.5rem" />
				<span>
					Next
					<br />
					<span class="link-title">{next.label}</span>
				</span>
			</a>
		)
	}
</div>

<style>
	.pagination-links {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
		gap: 1rem;
		margin-top: 3.5rem;
	}

	a {
		display: flex;
		align-items: center;
		justify-content: flex-start;
		gap: 0.5rem;
		width: 100%;
		flex-basis: calc(50% - 0.5rem);
		flex-grow: 1;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		padding: 1rem;
		text-decoration: none !important;
		color: var(--sl-color-gray-2) !important;
		box-shadow: var(--sl-shadow-md);
		overflow-wrap: anywhere;
		transition: border-color var(--motion, 0.18s);
	}

	a :global(*) {
		text-decoration: none !important;
	}

	[rel='next'] {
		justify-content: end;
		text-align: end;
		flex-direction: row-reverse;
	}

	a:hover {
		border-color: var(--sl-color-gray-2) !important;
	}

	.link-title {
		color: var(--sl-color-white);
		font-size: var(--sl-text-2xl);
		line-height: var(--sl-line-height-headings);
		text-decoration: none !important;
	}

	svg {
		flex-shrink: 0;
	}
</style>
