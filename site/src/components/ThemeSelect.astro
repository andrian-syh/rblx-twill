---
// Theme toggle button for switching between Dark (Factory) and Light (Ui) themes.
// Defaults to the user's OS/device theme, and remembers manual preference in localStorage.
---

<theme-toggle class="theme-toggle-wrapper">
	<button
		type="button"
		class="theme-toggle-btn"
		id="theme-toggle-btn"
		aria-label="Switch theme"
		title="Toggle between light and dark mode"
	>
		<!-- Sun Icon (shown in dark mode) -->
		<svg
			class="sun-icon"
			xmlns="http://www.w3.org/2000/svg"
			width="18"
			height="18"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<circle cx="12" cy="12" r="4"></circle>
			<path d="M12 2v2"></path>
			<path d="M12 20v2"></path>
			<path d="m4.93 4.93 1.41 1.41"></path>
			<path d="m17.66 17.66 1.41 1.41"></path>
			<path d="M2 12h2"></path>
			<path d="M20 12h2"></path>
			<path d="m6.34 17.66-1.41 1.41"></path>
			<path d="m19.07 4.93-1.41 1.41"></path>
		</svg>

		<!-- Moon Icon (shown in light mode) -->
		<svg
			class="moon-icon"
			xmlns="http://www.w3.org/2000/svg"
			width="18"
			height="18"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
		</svg>
	</button>
</theme-toggle>

<style>
	.theme-toggle-wrapper {
		display: flex;
		align-items: center;
	}

	.theme-toggle-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 34px;
		padding: 0;
		background: transparent;
		color: var(--sl-color-gray-2);
		border: 1px solid transparent;
		border-radius: var(--radius-buttons, 3px);
		cursor: pointer;
		transition: color var(--motion, 0.18s), background-color var(--motion, 0.18s), border-color var(--motion, 0.18s);
	}

	.theme-toggle-btn:hover {
		color: var(--sl-color-text);
		background-color: var(--sl-color-gray-6);
		border-color: var(--sl-color-hairline);
	}

	/* Dark mode: show Sun icon to switch to light */
	:global(:root:not([data-theme='light'])) .moon-icon {
		display: none;
	}
	:global(:root:not([data-theme='light'])) .sun-icon {
		display: block;
	}

	/* Light mode: show Moon icon to switch to dark */
	:global(:root[data-theme='light']) .sun-icon {
		display: none;
	}
	:global(:root[data-theme='light']) .moon-icon {
		display: block;
	}
</style>

<script>
	type Theme = 'dark' | 'light';
	const STORAGE_KEY = 'starlight-theme';

	function getSystemTheme(): Theme {
		return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
	}

	function getStoredTheme(): Theme | null {
		const stored = localStorage.getItem(STORAGE_KEY);
		if (stored === 'dark' || stored === 'light') return stored;
		return null;
	}

	function getActiveTheme(): Theme {
		return getStoredTheme() ?? getSystemTheme();
	}

	function applyTheme(theme: Theme) {
		document.documentElement.dataset.theme = theme;
		const btn = document.getElementById('theme-toggle-btn');
		if (btn) {
			const label = theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme';
			btn.setAttribute('aria-label', label);
			btn.setAttribute('title', label);
		}
	}

	class ThemeToggle extends HTMLElement {
		constructor() {
			super();
			// Apply initial theme based on stored preference or system
			applyTheme(getActiveTheme());

			const btn = this.querySelector('button');
			btn?.addEventListener('click', () => {
				const currentTheme = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
				const nextTheme: Theme = currentTheme === 'dark' ? 'light' : 'dark';
				localStorage.setItem(STORAGE_KEY, nextTheme);
				applyTheme(nextTheme);
			});
		}
	}

	// Listen to system theme changes if user hasn't explicitly set a preference
	window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', (e) => {
		if (!getStoredTheme()) {
			applyTheme(e.matches ? 'light' : 'dark');
		}
	});

	if (!customElements.get('theme-toggle')) {
		customElements.define('theme-toggle', ThemeToggle);
	}
</script>
